{
  "tenants": "*",
  "db": {
    "readUrl": "postgres://agente_leitura:SENHA@10.0.0.5:5432/sistema",
    "writeUrl": "postgres://agente_escrita:SENHA@10.0.0.5:5432/sistema",
    "tenantSetting": "app.current_tenant",
    "maxRows": 200,
    "maxWriteRows": 50,
    "timeoutMs": 10000,
    "allowDelete": false,
    "tenantColumn": "tenant_id",
    "labels": {
      "pedidos": {
        "nome": "Pedidos",
        "singular": "pedido",
        "registro": "Pedido {id}",
        "colunas": {
          "status": "Situação",
          "valor": "Valor (R$)"
        }
      },
      "clientes": {
        "nome": "Clientes",
        "singular": "cliente",
        "registro": "{nome}",
        "colunas": {
          "email": "E-mail"
        }
      }
    },
    "tenantQuery": "select id from tenants where subdominio = $1"
  },
  "web": {
    "baseUrl": "https://app.freeluxenergia.com.br",
    "tenantUrl": "https://{tenant}.freeluxenergia.com.br",
    "allowedHosts": [
      "*.freeluxenergia.com.br"
    ],
    "login": {
      "path": "/seguranca/login",
      "fields": {
        "#email": "{user}",
        "#senha": "{password}"
      },
      "submit": "#submeter"
    }
  },
  "rules": [
    {
      "members": [
        "*"
      ],
      "tenants": [
        "*"
      ],
      "db": "read",
      "web": "interact"
    },
    {
      "members": [
        "bruno"
      ],
      "tenants": [
        "*"
      ],
      "db": "write"
    }
  ],
  "approvers": "owner"
}
