# Copie para /opt/habblaud/.env.sede (permissão 600).
HABBLAUD_CENTRAL_HOST=127.0.0.1
HABBLAUD_CENTRAL_PORT=4800
HABBLAUD_ALLOWED_HOSTS=habblaud.suaempresa.com
# Membros e política (npm run central:member) e o gateway do sistema ficam em:
HABBLAUD_CENTRAL_CONFIG=/opt/habblaud/dados/central.json
HABBLAUD_GATEWAY_CONFIG=/opt/habblaud/dados/gateway.json
HABBLAUD_DATA_DIR=/opt/habblaud/dados
# Senha do usuário que o navegador do gateway usa para entrar no sistema (referenciada no gateway.json por passwordEnv).
SISTEMA_SENHA=troque-aqui
HABBLAUD_UPDATE_CHECK=0
